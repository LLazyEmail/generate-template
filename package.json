{
  "name": "@llazyemail/generate-template",
  "version": "1.6.0",
  "description": "Configurable engine for rendering named email templates to HTML.",
  "author": "Arthur Tkachenko",
  "license": "MIT",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "generate-template": "./dist/cli.js",
    "generate-template-assert": "./dist/assert-cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sandbox": "npm run build && node sandbox/example-usage.ts",
    "version-packages": "changeset version",
    "release": "node scripts/create-release.mjs",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.44.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "email",
    "template",
    "generator",
    "typescript"
  ],
  "homepage": "https://github.com/LLazyEmail/generate-template#readme",
  "bugs": {
    "url": "https://github.com/LLazyEmail/generate-template/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLazyEmail/generate-template.git"
  },
  "dependencies": {
    "markup-generator": "^3.2.0"
  }
}
